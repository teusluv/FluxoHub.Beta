<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
        Estratégia de logging:
        - dev: saída colorida e legível no console (padrão Logback)
        - prod: JSON estruturado (logstash-logback-encoder) — compatível com
                Grafana Loki, CloudWatch, Datadog, etc. sem configuração extra
    -->

    <springProfile name="dev,test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan(%logger{36}) - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="prod">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <!-- Campos extras incluídos em todos os logs de produção -->
                <customFields>{"service":"pod-backend","environment":"prod"}</customFields>
                <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
                    <maxDepthPerCause>20</maxDepthPerCause>
                    <shortenedClassNameLength>20</shortenedClassNameLength>
                </throwableConverter>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
    </springProfile>

    <!-- Sempre silenciar logs de libs verbosas que poluem em qualquer profile -->
    <logger name="org.hibernate.SQL" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="io.minio" level="WARN"/>

</configuration>
