# =============================================================================
# FluxoHub — Environment Variables Template
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais no repositório.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=fluxohub_db
POSTGRES_USER=fluxohub_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_PORT=5432

# --- MinIO (S3-compatible) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_CANHOTOS=canhotos

# --- Backend (Spring Boot) ---
BACKEND_PORT=8080
JWT_SECRET=change_me_to_a_256bit_random_secret_in_production
JWT_ACCESS_EXPIRY_MS=900000        # 15 minutos
JWT_REFRESH_EXPIRY_MS=604800000    # 7 dias

# --- Google Cloud Vision (OCR) ---
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcp-sa-key.json

# --- WhatsApp Business API (Meta Cloud API) ---
WHATSAPP_VERIFY_TOKEN=change_me_webhook_verify_token
WHATSAPP_APP_SECRET=change_me_app_secret_from_meta_dashboard
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token

# --- Admin Web (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXTAUTH_SECRET=change_me_in_production
NEXTAUTH_URL=http://localhost:3000

# --- Observabilidade ---
LOG_LEVEL=INFO
